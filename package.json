{
  "name": "shipai-site",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-kits.mjs && node scripts/build-showcase-sources.mjs && node scripts/build-hackathon-archive-manifest.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/migrate-team-membership.mjs && node scripts/build-kits.mjs && node scripts/build-showcase-sources.mjs && node scripts/build-hackathon-archive-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "sync-skills": "node scripts/sync-skills.mjs",
    "postbuild": "node scripts/apply-approved-workshop-hosts.mjs && node scripts/remove-approved-empty-team.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "ai": "^7.0.126",
    "libfx": "0.0.12",
    "lucide-react": "^1.24.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "simple-icons": "^16.26.0",
    "stripe": "^23.0.0"
  },
  "devDependencies": {
    "qrcode": "^1.5.4"
  }
}
